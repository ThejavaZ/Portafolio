---
import ClientRouter from "astro/components/ClientRouter.astro";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface LayoutProps {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  /** Tipo de contenido para Open Graph */
  type?: "website" | "article";
  /** Datos estructurados JSON-LD (schema.org) para rich results */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = "Portafolio de JavierSG, programador backend especializado en Python y ASP.NET.",
  image = "/logo.webp",
  lang = "es",
  type = "website",
  jsonLd,
} = Astro.props as LayoutProps;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400..600&family=Inter:wght@400..700&family=Space+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06070b" />
    <title>{title}</title>
    <meta name="author" content="JavierSG" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Bitácora de JavierSG"
      href={new URL("rss.xml", Astro.site)}
    />

    <!-- Open Graph (LinkedIn, WhatsApp, Facebook) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="JavierSG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }

    <ClientRouter />

    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body class="flex min-h-dvh flex-col bg-bg text-ink">
    {/* Accesibilidad: primer elemento enfocable del documento */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10000] focus:rounded-xl focus:bg-brand focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-glow"
    >
      Saltar al contenido
    </a>

    <!-- Fondo ambiental: aurora + rejilla + grano -->
    <div class="ambient" aria-hidden="true">
      <div class="ambient__grid"></div>
      <div class="ambient__glow ambient__glow--1"></div>
      <div class="ambient__glow ambient__glow--2"></div>
      <div class="ambient__glow ambient__glow--3"></div>
      <div class="ambient__noise"></div>
    </div>

    <Header />

    <main id="main" tabindex="-1" class="relative flex-1">
      <slot />
    </main>

    <Footer />

    <script>
    // Revelado progresivo al hacer scroll (una sola vez por elemento)
    let activeObservers: IntersectionObserver[] = [];

    function initReveal() {
      // Al navegar con View Transitions descartamos los observadores de la página anterior
      activeObservers.forEach((observer) => observer.disconnect());
      activeObservers = [];

      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-visible)");

      if (!("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-visible"));
        return;
      }

      const observer = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              obs.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
      );

      activeObservers.push(observer);
      targets.forEach((el) => observer.observe(el));
    }

    document.addEventListener("astro:page-load", initReveal);
  </script>
  </body>
</html>
