---
/**
 * Aviso para quien llega desde la versión en inglés: blog y certificados
 * no están traducidos, así que se le ofrece volver a /en.
 * Solo se muestra si el visitante estuvo en una página en inglés.
 */
---

<div id="lang-notice" class="shell hidden" role="status" aria-live="polite">
  <div class="card mb-6 flex flex-wrap items-center gap-4 p-4 sm:p-5">
    <span class="chip chip--accent shrink-0">ES</span>

    <p class="min-w-52 flex-1 text-sm leading-relaxed text-ink-2">
      <strong class="font-semibold text-ink">This section is only available in Spanish.</strong>
      The blog and certificates aren't translated yet — you can keep reading, or head back to
      the English site.
    </p>

    <a href="/en" class="btn btn--soft btn--sm">Back to the English site →</a>

    <button
      type="button"
      id="lang-notice-close"
      class="btn btn--ghost btn--sm"
      aria-label="Dismiss this notice"
    >
      Don't show again
    </button>
  </div>
</div>

<script>
  function initLanguageNotice() {
    const notice = document.getElementById("lang-notice");
    if (!notice) return;

    let preference: string | null = null;
    try {
      preference = localStorage.getItem("javiersg-lang");
    } catch {
      // localStorage no disponible: no mostramos nada
    }

    notice.classList.toggle("hidden", preference !== "en");

    document
      .getElementById("lang-notice-close")
      ?.addEventListener("click", () => {
        notice.classList.add("hidden");
        try {
          localStorage.setItem("javiersg-lang", "dismissed");
        } catch {
          // noop
        }
      });
  }

  document.addEventListener("astro:page-load", initLanguageNotice);
</script>
