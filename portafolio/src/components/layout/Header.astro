---
const menuItems = [
  { name: "Inicio", path: "/" },
  { name: "Sobre mí", path: "/about" },
  { name: "Proyectos", path: "/projects" },
  { name: "Contacto", path: "/contact" },
  { name: "Blog", path: "/blog" },
];
---

<!-- --- HEADER PRINCIPAL --- -->
<header class="sticky top-0 z-50 w-full bg-gray-900/80 backdrop-blur-md border-b border-blue-500/20 px-4 py-3">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    {/* Logo y Branding */}
    <div class="flex items-center gap-4">
      <a href="/" class="transition-transform hover:scale-105 active:scale-95">
        <img src="/logo.webp" alt="Logo de JavierSG" width="256" height="156" class="w-15 h-12 object-contain rounded-lg shadow-lg" />
      </a>
      <div class="hidden sm:block border-l border-gray-700 pl-4">
        <span class="block text-white font-bold text-lg leading-none">
          Javier<span class="text-blue-500">SG</span>
        </span>
        <p class="text-gray-500 text-[10px] uppercase tracking-widest mt-1 font-semibold">
          Backend Developer
        </p>
      </div>
    </div>

    {/* Desktop Nav (lg+) */}
    <nav class="hidden lg:flex gap-8 items-center font-medium">
      {menuItems.map((item) => (
        <a
          href={item.path}
          class="text-gray-300 hover:text-white transition-colors relative group"
        >
          {item.name}
          <span class="absolute -bottom-1 left-0 w-0 h-px bg-blue-500 transition-all group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    {/* Action Group */}
    <div class="flex items-center gap-3">
      {/* CV Button (Adaptable) */}
      <a
        href="/cv.pdf"
        download
        class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl font-bold text-sm transition-all shadow-lg shadow-blue-500/20 active:scale-95 flex items-center gap-2"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
          <path d="M14 3v4a1 1 0 0 0 1 1h4" />
          <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2" />
          <path d="M12 11v6m0 0l-3-3m3 3l3-3" />
        </svg>
        <span class="hidden md:inline">Descargar CV</span>
        <span class="md:hidden text-xs">CV</span>
      </a>

      {/* Hamburger Button (lg:hidden) */}
      <button
        id="menu-open"
        class="lg:hidden text-white p-2 hover:bg-white/10 rounded-lg transition-colors border border-white/5"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>
</header>

{/* --- MENÚ MÓVIL FULLSCREEN (Fuera del header para evitar bugs de fixed) --- */}
<div
  id="mobile-menu"
  class="fixed inset-0 bg-[#0a0a0a] flex flex-col items-center justify-center transition-all duration-500 z-[9999]"
>
  {/* Botón Cerrar */}
  <button
    id="menu-close"
    class="absolute top-8 right-8 text-gray-400 hover:text-white p-4 transition-transform hover:rotate-90"
    aria-label="Cerrar menú"
  >
    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <nav class="flex flex-col items-center gap-12">
    {menuItems.map((item) => (
      <a
        href={item.path}
        class="text-4xl font-black italic uppercase tracking-tighter text-gray-500 hover:text-blue-500 transition-all active:scale-95"
        data-mobile-link
      >
        {item.name}
      </a>
    ))}
    <a
      href="/contact"
      data-mobile-link
      class="mt-4 bg-blue-600 px-14 py-4 rounded-full text-white font-bold text-2xl uppercase italic tracking-widest shadow-[0_0_40px_rgba(37,99,235,0.3)] hover:bg-blue-500 transition-colors"
    >
      Contacto
    </a>
  </nav>
</div>

<style>
  #mobile-menu {
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }
  #mobile-menu.is-open {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  function initHeader() {
    const menu = document.getElementById("mobile-menu");
    const openBtn = document.getElementById("menu-open");
    const closeBtn = document.getElementById("menu-close");
    if (!menu || !openBtn || !closeBtn) return;

    // Tras cada navegación, asegurar menú cerrado y scroll liberado
    menu.classList.remove("is-open");
    document.body.style.overflow = "unset";
    openBtn.setAttribute("aria-expanded", "false");

    const setOpen = (open: boolean) => {
      menu.classList.toggle("is-open", open);
      document.body.style.overflow = open ? "hidden" : "unset";
      openBtn.setAttribute("aria-expanded", String(open));
    };

    openBtn.addEventListener("click", () => setOpen(true));
    closeBtn.addEventListener("click", () => setOpen(false));
    menu.querySelectorAll<HTMLElement>("[data-mobile-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }

  document.addEventListener("astro:page-load", initHeader);
</script>
