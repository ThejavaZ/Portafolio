---
const currentYear = new Date().getFullYear();

const navLinks = [
  { name: "Inicio", path: "/" },
  { name: "Sobre mí", path: "/about" },
  { name: "Proyectos", path: "/projects" },
  { name: "Stack", path: "/technologies" },
  { name: "Blog", path: "/blog" },
  { name: "Contacto", path: "/contact" },
];

const socialLinks = [
  {
    name: "GitHub",
    href: "https://github.com/ThejavaZ",
    icon: "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/javier-armando-sarmiento-gil-aa10b0249/",
    icon: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21h-4V9Z",
  },
  {
    name: "X",
    href: "https://x.com/TheJavaZs",
    icon: "M18.9 2H22l-6.8 7.8L23 22h-6.3l-4.9-6.4L6.2 22H3l7.3-8.3L2 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L7.3 3.8H5.5L17.8 20Z",
  },
  {
    name: "Correo",
    href: "mailto:jsdash10000@gmail.com",
    icon: "M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Zm2 .4V17h14V7.4l-7 4.6-7-4.6ZM7.4 7 12 10.1 16.6 7H7.4Z",
  },
];
---

<footer class="mt-24 border-t border-line bg-bg-2/60 backdrop-blur-sm">
  <div class="shell grid gap-12 py-14 md:grid-cols-12">
    {/* Marca */}
    <div class="md:col-span-5">
      <a href="/" class="font-display text-2xl font-bold tracking-tight">
        Javier<span class="text-grad">SG</span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-2">
        Desarrollador backend enfocado en crear soluciones eficientes, escalables y bien
        construidas. APIs, datos y todo lo que hay detrás de un buen producto.
      </p>

      <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-good opacity-70"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-good"></span>
        </span>
        <span class="font-mono text-[0.68rem] tracking-[0.18em] text-ink-2 uppercase">
          Disponible para proyectos
        </span>
      </div>
    </div>

    {/* Navegación */}
    <nav class="md:col-span-3" aria-label="Navegación del pie de página">
      <h3 class="font-mono text-[0.7rem] tracking-[0.24em] text-ink-3 uppercase">
        Navegación
      </h3>
      <ul class="mt-5 grid gap-3 text-sm">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.path}
                class="link-animated text-ink-2 transition-colors hover:text-white"
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Contacto */}
    <div class="md:col-span-4">
      <h3 class="font-mono text-[0.7rem] tracking-[0.24em] text-ink-3 uppercase">
        Contacto
      </h3>
      <ul class="mt-5 grid gap-3 text-sm">
        <li>
          <a
            href="mailto:jsdash10000@gmail.com"
            class="link-animated break-all text-ink-2 transition-colors hover:text-white"
          >jsdash10000@gmail.com</a
          >
        </li>
        <li>
          <a href="tel:+526622037327" class="link-animated text-ink-2 transition-colors hover:text-white"
            >+52 662 203 7327</a
          >
        </li>
        <li class="text-ink-3">Hermosillo, Sonora · México</li>
      </ul>

      <div class="mt-6 flex flex-wrap gap-2.5">
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target={social.href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener noreferrer"
              aria-label={social.name}
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-line bg-surface text-ink-2 transition-all hover:-translate-y-0.5 hover:border-brand/50 hover:text-white"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-4.5 w-4.5" aria-hidden="true">
                <path d={social.icon} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="shell flex flex-col items-center justify-between gap-3 py-6 font-mono text-[0.68rem] tracking-[0.16em] text-ink-3 uppercase sm:flex-row"
    >
      <span>© {currentYear} JavierSG · Todos los derechos reservados</span>
      <div class="flex items-center gap-5">
        <span>Hecho con Astro & Tailwind</span>
        <a href="#top" class="transition-colors hover:text-brand">Volver arriba ↑</a>
      </div>
    </div>
  </div>
</footer>
