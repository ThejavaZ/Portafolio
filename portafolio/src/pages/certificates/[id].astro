---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = async () => {
  const certificates = await getCollection("certificates");
  return certificates.map((certificate) => ({
    params: { id: certificate.id },
    props: { certificate },
  }));
};

const { certificate } = Astro.props;
const { data, id } = certificate;
const { title, image, firstColor, secondColor } = data;
const { Content } = await render(certificate);

// Mapa estático: Tailwind 4 no genera clases construidas dinámicamente (bg-${color}-500)
const gradientColors: Record<string, { from: string; to: string }> = {
  blue: { from: "from-brand", to: "to-brand-2" },
  yellow: { from: "from-amber-400", to: "to-amber-600" },
  orange: { from: "from-orange-400", to: "to-orange-600" },
  violet: { from: "from-violet-500", to: "to-violet-700" },
  red: { from: "from-rose-500", to: "to-rose-700" },
  green: { from: "from-emerald-500", to: "to-emerald-700" },
};

const glowFrom = gradientColors[firstColor]?.from ?? gradientColors.blue.from;
const glowTo = gradientColors[secondColor]?.to ?? gradientColors.blue.to;
---

<Layout
  title={`Certificado ${title} | JavierSG`}
  description={`Certificado oficial de ${title} expedido por Mimo.org.`}
  image={image.src}
>
  {/* Cabecera con glow de color */}
  <section class="relative overflow-hidden border-b border-line">
    <div
      class:list={[
        "absolute -top-32 left-1/2 h-72 w-[42rem] -translate-x-1/2 rounded-full blur-[110px]",
        "bg-gradient-to-br opacity-30",
        glowFrom,
        glowTo,
      ]}
    >
    </div>

    <div class="shell relative flex flex-col items-center gap-7 py-14 md:flex-row md:py-16">
      <div class="relative" data-reveal>
        <div
          class:list={[
            "absolute -inset-2 rounded-3xl bg-gradient-to-br opacity-40 blur-xl",
            glowFrom,
            glowTo,
          ]}
        >
        </div>
        <img
          transition:name={`img-${id}`}
          src={`/technologies/${title.toLowerCase()}.png`}
          alt={title}
          width="144"
          height="144"
          loading="lazy"
          class="relative h-32 w-32 rounded-2xl border border-line bg-surface-2 p-4 object-contain shadow-card md:h-36 md:w-36"
        />
      </div>

      <div class="text-center md:text-left">
        <p class="eyebrow" data-reveal>Certificación oficial</p>
        <h1
          class="mt-3 text-4xl leading-tight font-bold tracking-tight sm:text-6xl"
          data-reveal
          style="--reveal-delay: 60ms"
        >
          {title}
        </h1>
        <p
          class="mt-4 max-w-xl leading-relaxed text-ink-2"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          Validación de aptitudes técnicas y conocimientos avanzados en
          <strong class="font-semibold text-ink">{title}</strong>.
        </p>
      </div>
    </div>
  </section>

  {/* Detalles */}
  <section class="shell grid gap-8 py-14 lg:grid-cols-12">
    <div class="lg:col-span-7" data-reveal>
      <div class="card p-3 transition-transform duration-500 hover:-rotate-1">
        <Image
          src={image}
          width={900}
          alt={`Imagen del certificado ${title}`}
          class="w-full rounded-[0.95rem] border border-line"
        />
      </div>
    </div>

    <div class="lg:col-span-5" data-reveal style="--reveal-delay: 80ms">
      <div class="card flex h-full flex-col p-6 sm:p-8">
        <h2 class="flex items-center gap-3 font-mono text-[0.72rem] tracking-[0.24em] text-ink-3 uppercase">
          <span class="h-7 w-1 rounded-full bg-gradient-to-b from-brand to-accent"></span>
          Detalles del logro
        </h2>

        <div class="article mt-6 flex-1 text-base">
          <Content />
        </div>

        <div class="mt-8 flex items-center justify-between gap-4 border-t border-line pt-6">
          <a href="/#certificados" class="btn btn--ghost btn--sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
              <path d="M19 12H5m7-7l-7 7 7 7" />
            </svg>
            Volver
          </a>

          <button
            onclick="window.print()"
            class="btn btn--soft btn--sm"
          >
            Imprimir constancia
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>
