---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import SpanishOnlyNotice from "../../components/ui/SpanishOnlyNotice.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Datos estructurados: migas de pan + artículo
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const pageUrl = `${site}/blog/${post.id}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Bitácora", item: `${site}/blog` },
        { "@type": "ListItem", position: 3, name: post.data.title, item: pageUrl },
      ],
    },
    {
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.excerpt,
      datePublished: post.data.date.toISOString(),
      inLanguage: "es",
      articleSection: post.data.category,
      mainEntityOfPage: pageUrl,
      author: { "@type": "Person", name: post.data.author, url: `${site}/` },
      publisher: { "@type": "Person", "@id": `${site}/#javier`, name: "JavierSG" },
    },
  ],
};

const categoryTone: Record<string, string> = {
  Backend: "chip--brand",
  IoT: "chip--accent",
  Frontend: "chip--good",
  DevOps: "chip--accent",
  "Opinión": "chip--violet",
  Mobile: "chip--warn",
  Carrera: "chip--violet",
};

const formattedDate = post.data.date.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Tiempo de lectura estimado (~200 palabras por minuto)
const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));

// Artículos relacionados: primero de la misma categoría, después lo más reciente
const related = (await getCollection("blog"))
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => {
    const sameCategory =
      Number(b.data.category === post.data.category) -
      Number(a.data.category === post.data.category);
    return sameCategory || b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 2);
---

<Layout
  title={`${post.data.title} | JavierSG`}
  description={post.data.excerpt}
  type="article"
  jsonLd={jsonLd}
>
  <SpanishOnlyNotice />

  <article class="shell max-w-3xl py-14 md:py-20">
    <header class="mb-10 space-y-5">
      <div class="flex flex-wrap items-center gap-3" data-reveal>
        <a
          href="/blog"
          class="link-animated inline-flex items-center gap-2 font-mono text-[0.7rem] tracking-[0.2em] text-ink-2 uppercase transition-colors hover:text-brand"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
            <path d="M19 12H5m7-7l-7 7 7 7" />
          </svg>
          Bitácora
        </a>
        <span class="h-px flex-1 bg-line"></span>
        <span class:list={["chip", categoryTone[post.data.category] ?? "chip--brand"]}>
          {post.data.category}
        </span>
      </div>

      <h1
        class="text-3xl leading-[1.05] font-bold tracking-tight sm:text-5xl"
        data-reveal
        style="--reveal-delay: 60ms"
      >
        {post.data.title}
      </h1>

      <p
        class="font-mono text-xs tracking-[0.14em] text-ink-3 uppercase"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        {formattedDate} · {readingTime} min de lectura · {post.data.author}
      </p>
    </header>

    <div class="card p-6 sm:p-9" data-reveal style="--reveal-delay: 160ms">
      <div class="article">
        <Content />
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-14" aria-labelledby="related-title">
          <h2
            id="related-title"
            class="font-mono text-[0.7rem] tracking-[0.24em] text-ink-3 uppercase"
            data-reveal
          >
            Sigue leyendo
          </h2>

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {related.map((entry, index) => (
              <a
                href={`/blog/${entry.id}`}
                class="card card--hover group flex flex-col gap-3 p-6"
                data-reveal
                style={`--reveal-delay: ${index * 70}ms`}
              >
                <div class="flex items-center justify-between gap-3">
                  <span class:list={["chip", categoryTone[entry.data.category] ?? "chip--brand"]}>
                    {entry.data.category}
                  </span>
                  <span class="font-mono text-[0.66rem] tracking-[0.14em] text-ink-3 uppercase">
                    {entry.data.date.toLocaleDateString("es-ES", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </span>
                </div>
                <h3 class="leading-snug font-semibold transition-colors group-hover:text-brand">
                  {entry.data.title}
                </h3>
                <p class="line-clamp-2 text-sm leading-relaxed text-ink-2">
                  {entry.data.excerpt}
                </p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
      <a href="/blog" class="btn btn--ghost btn--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
          <path d="M19 12H5m7-7l-7 7 7 7" />
        </svg>
        Volver a la bitácora
      </a>
      <a href="/contact" class="link-animated font-mono text-xs tracking-[0.18em] text-ink-2 uppercase hover:text-brand">
        ¿Hablamos de esto?
      </a>
    </div>
  </article>
</Layout>
