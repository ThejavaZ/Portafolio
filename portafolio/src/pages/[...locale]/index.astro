---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import photo from "../../assets/javier-sarmiento.jpg";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import ButtonLink from "../../components/ui/ButtonLink.astro";
import { projectStatus } from "../../data/projectStatus";
import { allTechs } from "../../data/tech-data";
import { techName } from "../../i18n/tech";

export function getStaticPaths() {
  return [
    { params: { locale: undefined } }, // español en /
    { params: { locale: "en" } }, // inglés en /en
  ];
}

const locale = Astro.params.locale === "en" ? "en" : "es";
const isEn = locale === "en";

/** Ruta localizada (las páginas solo en español no se prefijan) */
const link = (path: string) => (isEn ? (path === "/" ? "/en" : `/en${path}`) : path);

const works = (await getCollection(isEn ? "worksEn" : "works")).sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate)
);
const certificates = await getCollection("certificates");
const allProjects = (await getCollection(isEn ? "projectsEn" : "projects")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const featured = allProjects.slice(0, 3);

// Copy de la página en ambos idiomas
const L = isEn
  ? {
      status: "Available for new challenges",
      heroBefore: "I build the",
      heroAccent: "backend",
      heroAfter: "that keeps your product running.",
      intro: "I'm",
      role: "a backend developer specializing in",
      and: "and",
      tail: "I design APIs, model data and ship services built to last.",
      ctaProjects: "View projects",
      ctaTalk: "Let's talk",
      stats: ["Projects", "Certificates", "Specialties", "Companies"],
      featuredEyebrow: "Recent work",
      featuredTitle: "Featured projects",
      viewAll: "View all",
      experienceEyebrow: "Background",
      experienceTitle: "Professional experience",
      experienceDesc: "Where I've added value and the technology I've worked with.",
      specialtiesEyebrow: "Explore",
      specialtiesTitle: "Technologies I use",
      specialtiesDesc: "Browse the full stack by category.",
      certsEyebrow: "Credentials",
      certsTitle: "Certificates",
      ctaEyebrow: "Next step",
      ctaTitleA: "Got a project in mind?",
      ctaTitleB: "Let's build it.",
      ctaText: "Write me and tell me what you need: I reply fast and straight to the point.",
      ctaSend: "Send a message",
      ctaCv: "Download CV",
      inLanguage: "en",
      jobTitle: "Backend Developer",
      personDescription:
        "Backend developer specializing in Python and ASP.NET: APIs, databases and software architecture.",
    }
  : {
      status: "Disponible para nuevos retos",
      heroBefore: "Construyo el",
      heroAccent: "backend",
      heroAfter: "que sostiene tu producto.",
      intro: "Soy",
      role: "programador backend especializado en",
      and: "y",
      tail: "Diseño APIs, modelo datos y despliego servicios pensados para durar.",
      ctaProjects: "Ver proyectos",
      ctaTalk: "Hablemos",
      stats: ["Proyectos", "Certificados", "Especialidades", "Empresas"],
      featuredEyebrow: "Trabajo reciente",
      featuredTitle: "Proyectos destacados",
      viewAll: "Ver todos",
      experienceEyebrow: "Trayectoria",
      experienceTitle: "Experiencia profesional",
      experienceDesc: "Dónde he aportado valor y con qué tecnología he trabajado.",
      specialtiesEyebrow: "Explora",
      specialtiesTitle: "Tecnologías que uso",
      specialtiesDesc: "Explora el stack completo por categoría.",
      certsEyebrow: "Validación",
      certsTitle: "Certificados",
      ctaEyebrow: "Siguiente paso",
      ctaTitleA: "¿Tienes un proyecto en mente?",
      ctaTitleB: "Construyámoslo.",
      ctaText: "Escríbeme y platícame qué necesitas: respondo rápido y sin rodeos.",
      ctaSend: "Enviar mensaje",
      ctaCv: "Descargar CV",
      inLanguage: "es",
      jobTitle: "Desarrollador Backend",
      personDescription:
        "Programador backend especializado en Python y ASP.NET: APIs, bases de datos y arquitectura de software.",
    };

const stats = [
  { value: String(allProjects.length), suffix: "+", label: L.stats[0] },
  { value: String(certificates.length), suffix: "", label: L.stats[1] },
  { value: String(allTechs.length), suffix: "", label: L.stats[2] },
  { value: String(works.length), suffix: "", label: L.stats[3] },
];

// Datos estructurados: identidad del sitio + persona
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const personId = `${site}/#javier`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Javier Armando Sarmiento Gil",
      alternateName: "JavierSG",
      jobTitle: L.jobTitle,
      description: L.personDescription,
      url: `${site}/`,
      email: "mailto:jsdash10000@gmail.com",
      image: `${site}/logo.webp`,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Hermosillo",
        addressRegion: "Sonora",
        addressCountry: "MX",
      },
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Universidad Tecnológica de Hermosillo (UTH)",
      },
      knowsLanguage: ["es", "en"],
      knowsAbout: [
        "Python",
        "ASP.NET",
        "C#",
        "PostgreSQL",
        "SQL Server",
        "Docker",
        "Diseño de APIs",
        "Arquitectura de bases de datos",
      ],
      sameAs: [
        "https://github.com/ThejavaZ",
        "https://www.linkedin.com/in/javier-armando-sarmiento-gil-aa10b0249/",
        "https://x.com/TheJavaZs",
      ],
    },
    {
      "@type": "WebSite",
      "@id": isEn ? `${site}/en#website` : `${site}/#website`,
      url: isEn ? `${site}/en` : `${site}/`,
      name: "JavierSG",
      inLanguage: L.inLanguage,
      publisher: { "@id": personId },
    },
  ],
};

const socials = [
  { name: "GitHub", short: "GH", href: "https://github.com/ThejavaZ" },
  {
    name: "LinkedIn",
    short: "IN",
    href: "https://www.linkedin.com/in/javier-armando-sarmiento-gil-aa10b0249/",
  },
];
---

<Layout
  title={
    isEn
      ? "JavierSG — Backend Developer | Python, .NET & PostgreSQL"
      : "JavierSG — Backend Developer · Python, .NET y PostgreSQL"
  }
  description={
    isEn
      ? "JavierSG's portfolio: backend developer specializing in Python and ASP.NET. Projects, experience, technical articles and certificates."
      : "Portafolio de JavierSG, programador backend especializado en Python y ASP.NET: proyectos, experiencia, artículos técnicos y certificados."
  }
  locale={locale}
  alternate
  jsonLd={jsonLd}
>
  {/* ================= HERO ================= */}
  <section class="shell relative grid items-center gap-14 pt-14 pb-20 md:pt-20 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <span class="chip chip--accent" data-reveal>
        <span class="h-1.5 w-1.5 rounded-full bg-good"></span>
        {L.status}
      </span>

      <h1
        class="mt-7 text-[2.6rem] leading-[0.98] font-bold tracking-tight sm:text-6xl lg:text-[4.25rem]"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        {L.heroBefore} <span class="text-grad">{L.heroAccent}</span> {L.heroAfter}
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2"
        data-reveal
        style="--reveal-delay: 160ms"
      >
        {L.intro} <strong class="font-semibold text-ink">Javier</strong>, {L.role}
        <span class="font-mono text-[0.95em] text-accent">Python</span> {L.and}
        <span class="font-mono text-[0.95em] text-accent">ASP.NET</span>. {L.tail}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 240ms">
        <ButtonLink href={link("/projects")} size="lg">
          {L.ctaProjects}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="h-4 w-4"
          >
            <path d="M5 12h14m-7-7l7 7-7 7" />
          </svg>
        </ButtonLink>
        <ButtonLink href={link("/contact")} variant="ghost" size="lg">
          {L.ctaTalk}
        </ButtonLink>

        <div class="flex items-center gap-2 sm:ml-2">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-surface font-mono text-xs font-semibold text-ink-2 transition-all hover:-translate-y-0.5 hover:border-brand/50 hover:text-white"
              aria-label={social.name}
            >
              {social.short}
            </a>
          ))}
        </div>
      </div>

      <div class="mt-12 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-4">
        {stats.map((stat, index) => (
          <div
            class="card px-4 py-5 text-center"
            data-reveal
            style={`--reveal-delay: ${280 + index * 60}ms`}
          >
            <p class="font-display text-3xl font-bold text-white">
              {stat.value}
              <span class="text-brand">{stat.suffix}</span>
            </p>
            <p class="mt-1 font-mono text-[0.62rem] tracking-[0.18em] text-ink-3 uppercase">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
    </div>

    {/* Retrato */}
    <div
      class="relative mx-auto w-full max-w-sm lg:col-span-5"
      data-reveal
      style="--reveal-delay: 200ms"
    >
      <div class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-gradient-to-br from-brand/30 via-accent/10 to-brand-2/25 blur-3xl"></div>

      <div class="card overflow-hidden p-2">
        <Image
          src={photo}
          alt="Javier Armando Sarmiento Gil"
          width={640}
          height={800}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full rounded-[1.1rem] object-cover object-[50%_22%] saturate-[0.9]"
        />
      </div>

      <span class="chip chip--brand absolute -left-3 top-8 shadow-card backdrop-blur-md sm:-left-8">
        Python
      </span>
      <span class="chip absolute -right-2 top-1/3 shadow-card backdrop-blur-md sm:-right-8">
        .NET
      </span>
      <span class="chip chip--accent absolute -bottom-4 left-8 shadow-card backdrop-blur-md sm:left-16">
        PostgreSQL
      </span>
    </div>
  </section>

  {/* ================= PROYECTOS DESTACADOS ================= */}
  {featured.length > 0 && (
    <section class="shell py-16">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow={L.featuredEyebrow} title={L.featuredTitle} class="flex-1" />
        <a
          href={link("/projects")}
          class="link-animated mb-10 inline-flex items-center gap-2 font-mono text-xs tracking-[0.18em] text-ink-2 uppercase transition-colors hover:text-white md:mb-14"
        >
          {L.viewAll}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="h-3.5 w-3.5"
          >
            <path d="M5 12h14m-7-7l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((project, index) => {
          const { id, data } = project;
          const statusInfo = data.status ? projectStatus[data.status] : undefined;
          return (
            <a
              href={link(`/projects/${id}`)}
              class="card card--hover group flex flex-col overflow-hidden"
              data-reveal
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <div class="relative aspect-video overflow-hidden">
                <Image
                  transition:name={`img-${id}`}
                  src={data.image}
                  alt={data.title ?? (isEn ? "Project image" : "Imagen del proyecto")}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/10 to-transparent"></div>
                {statusInfo && (
                  <span class:list={["chip absolute top-3 left-3", statusInfo.cls]}>
                    {isEn ? statusInfo.labelEn : statusInfo.label}
                  </span>
                )}
              </div>

              <div class="flex flex-1 flex-col gap-3 p-6">
                <h3 class="text-xl leading-snug font-semibold transition-colors group-hover:text-brand">
                  {data.title}
                </h3>
                <p class="line-clamp-3 text-sm leading-relaxed text-ink-2">{data.description}</p>
                <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
                  {(data.frameworks ?? []).slice(0, 3).map((tech) => (
                    <span class="chip">{tech}</span>
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {/* ================= EXPERIENCIA ================= */}
  <section class="shell py-16">
    <SectionHeading
      eyebrow={L.experienceEyebrow}
      title={L.experienceTitle}
      description={L.experienceDesc}
    />

    <ol class="relative space-y-6 border-l border-line pl-6 sm:pl-10">
      {works.map((work, index) => (
        <li class="relative" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
          <span
            class:list={[
              "absolute top-7 -left-[1.68rem] h-3 w-3 rounded-full ring-4 ring-bg sm:-left-[2.68rem]",
              index === 0
                ? "bg-brand shadow-[0_0_16px_rgba(79,125,255,0.9)]"
                : "bg-surface-2 border border-line-strong",
            ]}
          />
          <article class:list={["card p-6", index === 0 && "border-brand/30"]}>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-center gap-4">
                {work.data.logo && (
                  <img
                    src={work.data.logo}
                    alt={isEn ? `${work.data.company} logo` : `Logo de ${work.data.company}`}
                    width="48"
                    height="48"
                    loading="lazy"
                    class:list={[
                      "h-12 w-12 shrink-0 rounded-xl border border-line bg-surface-2 object-contain p-1.5",
                      index !== 0 && "opacity-70",
                    ]}
                  />
                )}
                <div>
                  <h3 class="text-lg font-semibold">{work.data.role}</h3>
                  <p class="text-sm text-brand">{work.data.company}</p>
                </div>
              </div>

              <span class:list={["chip self-start sm:self-auto", index === 0 && "chip--brand"]}>
                {work.data.period}
              </span>
            </div>

            {work.data.achievements && work.data.achievements.length > 0 && (
              <ul class="mt-5 grid gap-2 border-t border-line pt-4">
                {work.data.achievements.map((achievement) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink-2">
                    <span
                      class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
                      aria-hidden="true"
                    />
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))}
    </ol>
  </section>

  {/* ================= ESPECIALIDADES ================= */}
  <section class="shell py-16">
    <SectionHeading
      eyebrow={L.specialtiesEyebrow}
      title={L.specialtiesTitle}
      description={L.specialtiesDesc}
      align="center"
    />

    <div class="flex flex-wrap justify-center gap-3" data-reveal>
      {allTechs.map((tech) => (
        <a
          href={link(`/technologies/${tech.id}`)}
          class="card card--hover flex items-center gap-3 px-5 py-3.5"
        >
          <img
            src={tech.logo}
            alt=""
            width="28"
            height="28"
            loading="lazy"
            class="h-7 w-7 object-contain"
          />
          <span class="font-mono text-xs tracking-[0.12em] text-ink-2 uppercase">
            {techName(tech.id, tech.name, locale)}
          </span>
        </a>
      ))}
    </div>
  </section>

  {/* ================= CERTIFICADOS ================= */}
  <section class="shell py-14" id="certificados">
    <SectionHeading eyebrow={L.certsEyebrow} title={L.certsTitle} align="center" />

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {certificates.map((certificate, index) => (
        <a
          href={`/certificates/${certificate.id}`}
          class="card card--hover group flex flex-col items-center gap-3 p-6 text-center"
          data-reveal
          style={`--reveal-delay: ${index * 50}ms`}
        >
          <img
            src={`/technologies/${certificate.data.title}.webp`}
            alt={certificate.data.title}
            width="56"
            height="56"
            loading="lazy"
            class="h-14 w-14 object-contain opacity-60 grayscale transition-all duration-500 group-hover:scale-110 group-hover:opacity-100 group-hover:grayscale-0"
          />
          <span class="font-mono text-[0.68rem] tracking-[0.16em] text-ink-3 uppercase transition-colors group-hover:text-white">
            {certificate.data.title}
          </span>
        </a>
      ))}
    </div>
  </section>

  {/* ================= CTA ================= */}
  <section class="shell py-16">
    <div class="card relative overflow-hidden px-6 py-14 text-center sm:px-12" data-reveal>
      <div class="absolute -top-24 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-brand/25 blur-3xl"></div>

      <div class="relative">
        <p class="eyebrow justify-center">{L.ctaEyebrow}</p>
        <h2 class="mx-auto mt-5 max-w-2xl text-3xl leading-tight font-bold sm:text-4xl">
          {L.ctaTitleA} <span class="text-grad">{L.ctaTitleB}</span>
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-ink-2">{L.ctaText}</p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <ButtonLink href={link("/contact")} size="lg">
            {L.ctaSend}
          </ButtonLink>
          <ButtonLink href="/cv.pdf" variant="ghost" size="lg" download>
            {L.ctaCv}
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>
</Layout>
