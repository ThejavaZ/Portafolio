---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { allTechs } from "../../../data/tech-data";
import SectionHeading from "../../../components/ui/SectionHeading.astro";

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: "en" } }];
}

const locale = Astro.params.locale === "en" ? "en" : "es";
---

<Layout
  title="Stack tecnológico | JavierSG"
  description="Todas las especialidades de JavierSG: Python, bases de datos, backend, frontend, DevOps, escritorio, móvil, Git y herramientas."
  locale={locale}
  alternate
>
  <section class="shell py-14 md:py-20">
    <SectionHeading
      eyebrow="Stack"
      title="Tecnologías y especialidades"
      description="Nueve categorías con el stack completo, las herramientas y los casos de uso de cada una."
    />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        allTechs.map((tech, index) => (
          <a
            href={`/technologies/${tech.id}`}
            class="card card--hover group flex h-full flex-col gap-4 p-6"
            data-reveal
            style={`--reveal-delay: ${(index % 3) * 70}ms`}
          >
            <div class="flex items-center gap-4">
              <div class="rounded-2xl border border-line bg-surface-2 p-3 transition-transform duration-300 group-hover:-translate-y-1">
                <Image
                  src={tech.logo}
                  alt={tech.name}
                  width={44}
                  height={44}
                  class="h-11 w-11 object-contain"
                />
              </div>
              <div>
                <h2 class="text-lg leading-tight font-semibold transition-colors group-hover:text-brand">
                  {tech.name}
                </h2>
                <p class="mt-1 font-mono text-[0.66rem] tracking-[0.16em] text-ink-3 uppercase">
                  {tech.stack.length} tecnologías
                </p>
              </div>
            </div>

            {
              tech.description && (
                <p class="text-sm leading-relaxed text-ink-2">{tech.description}</p>
              )
            }

            <span class="mt-auto inline-flex items-center gap-2 font-mono text-[0.68rem] tracking-[0.18em] text-ink-2 uppercase transition-all group-hover:gap-3.5 group-hover:text-brand">
              Ver stack
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                class="h-3.5 w-3.5"
              >
                <path d="M5 12h14m-7-7l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
