---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { allTechs } from "../../../data/tech-data";

export function getStaticPaths() {
  return allTechs.flatMap((tech) => [
    { params: { locale: undefined, technology: tech.id }, props: { tech } },
    { params: { locale: "en", technology: tech.id }, props: { tech } },
  ]);
}

const locale = Astro.params.locale === "en" ? "en" : "es";

const { tech } = Astro.props;

// "theme" viene de los datos con clases tipo `bg-green-700 dark:bg-gray-900`.
// Nos quedamos solo con las de color para usarlas como glow del encabezado.
const themeGlow = tech.theme
  .split(/\s+/)
  .filter((cls) => cls && !cls.startsWith("dark:"))
  .join(" ");
---

<Layout
  title={`${tech.name} | JavierSG`}
  description={tech.description ?? `Stack, herramientas y ecosistema de ${tech.name}.`}
  image={tech.logo}
  locale={locale}
  alternate
>
  {/* ============ HEADER ============ */}
  <header class="relative overflow-hidden border-b border-line">
    <div class:list={["absolute inset-0 opacity-25 blur-3xl", themeGlow]} aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-bg"></div>

    <div class="shell relative flex flex-col items-center gap-6 py-14 text-center md:py-16">
      <div class="card p-5" data-reveal>
        <Image
          transition:name={`${tech.id}-tech`}
          src={tech.logo}
          alt={tech.name}
          width={96}
          height={96}
          fit="contain"
          class="h-24 w-24 object-contain drop-shadow-[0_0_25px_rgba(255,255,255,0.25)]"
        />
      </div>

      <div>
        <p class="eyebrow justify-center" data-reveal style="--reveal-delay: 60ms">
          Especialidad
        </p>
        <h1
          class="mt-3 text-4xl leading-tight font-bold tracking-tight sm:text-6xl"
          data-reveal
          style="--reveal-delay: 100ms"
        >
          {tech.name}
        </h1>
        {
          tech.description && (
            <p
              class="mx-auto mt-4 max-w-2xl leading-relaxed text-ink-2"
              data-reveal
              style="--reveal-delay: 160ms"
            >
              {tech.description}
            </p>
          )
        }
      </div>
    </div>
  </header>

  {/* ============ STACK ============ */}
  <main class="shell py-14 md:py-16">
    <div class="flex flex-wrap items-center justify-between gap-4" data-reveal>
      <div>
        <p class="eyebrow">Stack & ecosistema</p>
        <p class="mt-3 text-sm text-ink-2">
          {tech.stack.length} tecnologías en esta categoría
        </p>
      </div>
      <a href="/technologies" class="btn btn--ghost btn--sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
          <path d="M19 12H5m7-7l-7 7 7 7" />
        </svg>
        Ver todas las especialidades
      </a>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {
        tech.stack.map((item, index) => (
          <div
            class="card card--hover group flex flex-col items-center gap-3 p-6 text-center"
            data-reveal
            style={`--reveal-delay: ${(index % 4) * 60}ms`}
          >
            <div class="rounded-2xl border border-line bg-surface-2 p-4 transition-transform duration-300 group-hover:-translate-y-1">
              <Image
                src={`/technologies/${item.img}`}
                alt={item.name}
                width={56}
                height={56}
                class="h-14 w-14 object-contain"
              />
            </div>
            <h2 class="font-display text-base leading-tight font-semibold">{item.name}</h2>
            <span class="chip chip--brand">{item.type}</span>
          </div>
        ))
      }
    </div>
  </main>
</Layout>
