---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import photo from "../../assets/javier-sarmiento.jpg";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import ButtonLink from "../../components/ui/ButtonLink.astro";
import { techName } from "../../i18n/tech";

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: "en" } }];
}

const locale = Astro.params.locale === "en" ? "en" : "es";
const isEn = locale === "en";

/** Ruta localizada */
const link = (path: string) => (isEn ? (path === "/" ? "/en" : `/en${path}`) : path);

const L = isEn
  ? {
      metaTitle: "About | JavierSG",
      metaDescription:
        "JavierSG's background, core stack and specialties: UTH graduate passionate about backend development.",
      eyebrow: "About me",
      title: "My background",
      p1a: "I'm a graduate of ",
      p1b: " with one driving idea: understanding how the pieces fit together. That's why I specialized in ",
      p1c: ", always looking for efficiency and scalability in everything I build.",
      p1Strong: "server and database architecture",
      p2: "Today I build software for corporate clients: APIs, integrations and services that have to work on Monday at 8 a.m.",
      ctaProjects: "View projects",
      ctaContact: "Contact",
      photoAlt: "Photo of Javier Armando Sarmiento Gil",
      stackEyebrow: "Core stack",
      stackTitle: "What I work with daily",
      stackDesc: "Backend, data and infrastructure: the core I build on.",
      stackLead:
        "API and backend services development with C# and .NET, focused on maintainability, data persistence and software architecture. Complementary experience in Python, automation and cross-platform applications.",
      specialtiesEyebrow: "Explore",
      specialtiesTitle: "Specialties",
      specialtiesDesc: "Each category with its stack, tools and use cases.",
      workEyebrow: "Work experience",
      workTitle: "Where I've worked",
      workDesc: "Professional history, most recent first.",
      companyLogo: (company: string) => `${company} logo`,
    }
  : {
      metaTitle: "Acerca de | JavierSG",
      metaDescription:
        "Trayectoria, stack principal y especialidades de JavierSG: egresado de la UTH apasionado por el desarrollo backend.",
      eyebrow: "Sobre mí",
      title: "Mi trayectoria",
      p1a: "Soy egresado de la ",
      p1b: " y me mueve una sola idea: entender cómo encajan las piezas. Por eso me especialicé en la ",
      p1c: ", buscando eficiencia y escalabilidad en cada proyecto que toco.",
      p1Strong: "arquitectura de servidores y bases de datos",
      p2: "Hoy trabajo construyendo software para clientes corporativos: APIs, integraciones y servicios que tienen que funcionar el lunes a las 8 a. m.",
      ctaProjects: "Ver proyectos",
      ctaContact: "Contacto",
      photoAlt: "Foto de Javier Armando Sarmiento Gil",
      stackEyebrow: "Stack principal",
      stackTitle: "Con qué trabajo a diario",
      stackDesc: "Backend, datos e infraestructura: el núcleo sobre el que construyo.",
      stackLead:
        "Desarrollo de APIs y servicios backend con C# y .NET, orientados a la mantenibilidad, la persistencia de datos y la arquitectura de software. Experiencia complementaria en Python, automatización y aplicaciones multiplataforma.",
      specialtiesEyebrow: "Explora",
      specialtiesTitle: "Especialidades",
      specialtiesDesc: "Cada categoría con su stack, herramientas y casos de uso.",
      workEyebrow: "Experiencia laboral",
      workTitle: "Dónde he trabajado",
      workDesc: "Trayectoria profesional ordenada de más reciente a más antigua.",
      companyLogo: (company: string) => `Logo de ${company}`,
    };

const works = (await getCollection(isEn ? "worksEn" : "works")).sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate)
);

const mainStack = [
  { name: "C# / .NET", src: "/technologies/net.webp", ring: "hover:border-violet-400/50" },
  { name: "PostgreSQL", src: "/technologies/psql.webp", ring: "hover:border-brand/50" },
  { name: "SQL Server", src: "/technologies/sql-server.webp", ring: "hover:border-rose-400/50" },
  { name: "Python", src: "/technologies/python.webp", ring: "hover:border-emerald-400/50" },
  { name: "Docker", src: "/technologies/docker.webp", ring: "hover:border-sky-400/50" },
];

const specialties = [
  { name: "Python", href: "/python", icon: "python.webp" },
  { name: "Bases de Datos", href: "/sql", icon: "sql.webp" },
  { name: "Frontend", href: "/client", icon: "client.webp" },
  { name: "Backend", href: "/server", icon: "server.webp" },
  { name: "DevOps", href: "/devops", icon: "docker.webp" },
  { name: "Escritorio", href: "/desktop", icon: "desktop.webp" },
  { name: "Móvil", href: "/mobile", icon: "mobile.webp" },
  { name: "Git", href: "/git", icon: "git.webp" },
  { name: "Herramientas", href: "/tools", icon: "vscode.webp" },
];
---

<Layout
  title={L.metaTitle}
  description={L.metaDescription}
  image={photo.src}
  locale={locale}
  alternate
>
  {/* ============ TRAYECTORIA ============ */}
  <section class="shell grid items-center gap-12 pt-14 pb-16 md:pt-20 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <SectionHeading
        eyebrow={L.eyebrow}
        title={L.title}
        suffix=""
        spacing="none"
      />

      <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-2" data-reveal>
        <p>
          {L.p1a}<strong class="font-semibold text-ink">UTH</strong>{L.p1b}
          <strong class="font-semibold text-ink">{L.p1Strong}</strong>{L.p1c}
        </p>
        <p>{L.p2}</p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 120ms">
        <span class="chip chip--brand">Backend</span>
        <span class="chip chip--accent">API Design</span>
        <span class="chip chip--violet">Database Architecture</span>
        <span class="chip">Hermosillo, MX</span>
      </div>

      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 180ms">
        <ButtonLink href={link("/projects")}>{L.ctaProjects}</ButtonLink>
        <ButtonLink href={link("/contact")} variant="ghost">{L.ctaContact}</ButtonLink>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-sm lg:col-span-5" data-reveal style="--reveal-delay: 140ms">
      <div
        class="absolute -inset-5 -z-10 rounded-[2.5rem] bg-gradient-to-br from-brand/30 to-brand-2/25 blur-3xl"
      >
      </div>
      <div class="card p-2">
        <Image
          src={photo}
          alt={L.photoAlt}
          loading="lazy"
          class="aspect-square w-full rounded-[1.1rem] object-cover object-[50%_25%]"
        />
      </div>
    </div>
  </section>

  {/* ============ MAIN STACK ============ */}
  <section class="shell py-14">
    <SectionHeading
      eyebrow={L.stackEyebrow}
      title={L.stackTitle}
      align="center"
      description={L.stackDesc}
    />

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5" data-reveal>
      {
        mainStack.map((tech) => (
          <div class="card card--hover flex flex-col items-center gap-3 p-6 text-center">
            <div class:list={["rounded-2xl border border-line bg-surface-2 p-4 transition-all duration-300", tech.ring]}>
              <Image src={tech.src} alt={tech.name} width={48} height={48} class="h-12 w-12 object-contain" />
            </div>
            <h3 class="font-mono text-[0.7rem] tracking-[0.14em] text-ink-2 uppercase">
              {tech.name}
            </h3>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-10 max-w-3xl text-center" data-reveal>
      <p class="font-mono text-[0.7rem] tracking-[0.28em] text-accent uppercase">
        Backend development · API design · Database architecture
      </p>
      <p class="mt-4 leading-relaxed text-ink-2">{L.stackLead}</p>
    </div>
  </section>

  {/* ============ ESPECIALIDADES ============ */}
  <section class="shell py-14">
    <SectionHeading
      eyebrow={L.specialtiesEyebrow}
      title={L.specialtiesTitle}
      description={L.specialtiesDesc}
      align="center"
    />

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
      {
        specialties.map((item, index) => (
          <a
            href={link(`/technologies${item.href}`)}
            class="card card--hover group flex flex-col items-center gap-3 p-6 text-center"
            data-reveal
            style={`--reveal-delay: ${(index % 5) * 60}ms`}
          >
            <div class="rounded-xl border border-line bg-surface-2 p-3 transition-transform duration-300 group-hover:-translate-y-1">
              <Image
                src={`/technologies/${item.icon}`}
                alt={techName(item.href.replace("/", ""), item.name, locale)}
                width={40}
                height={40}
                class="h-10 w-10 object-contain"
              />
            </div>
            <h3 class="font-mono text-[0.7rem] tracking-[0.14em] text-ink-2 uppercase transition-colors group-hover:text-white">
              {techName(item.href.replace("/", ""), item.name, locale)}
            </h3>
          </a>
        ))
      }
    </div>
  </section>

  {/* ============ EXPERIENCIA LABORAL ============ */}
  <section class="shell py-14">
    <SectionHeading
      eyebrow={L.workEyebrow}
      title={L.workTitle}
      suffix=""
      description={L.workDesc}
    />

    <ul class="grid gap-4">
      {
        works.map((work, index) => (
          <li
            class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between"
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <div class="flex items-center gap-4">
              {work.data.logo && (
                <img
                  src={work.data.logo}
                  alt={L.companyLogo(work.data.company)}
                  width="44"
                  height="44"
                  loading="lazy"
                  class="h-11 w-11 shrink-0 rounded-xl border border-line bg-surface-2 object-contain p-1.5"
                />
              )}
              <div>
                <span class="block font-semibold">{work.data.role}</span>
                <span class="block text-sm text-ink-2">{work.data.company}</span>
              </div>
            </div>
            <span class:list={["chip self-start sm:self-auto", index === 0 && "chip--brand"]}>
              {work.data.period}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
