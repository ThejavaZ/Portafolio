---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { projectStatus } from "../../data/projectStatus";
import SectionHeading from "../../components/ui/SectionHeading.astro";

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: "en" } }];
}

const locale = Astro.params.locale === "en" ? "en" : "es";
const isEn = locale === "en";

/** Ruta localizada */
const link = (path: string) => (isEn ? (path === "/" ? "/en" : `/en${path}`) : path);

const L = isEn
  ? {
      title: "Projects",
      description:
        "Projects built by JavierSG: ERPs, mobile apps, AI assistants and enterprise systems.",
      eyebrow: "Portfolio",
      subtitle: "Professional work and personal projects. Filter by technology or name.",
      placeholder: "Search by technology or name...",
      searchAria: "Search projects by name or technology",
      count: "repositories found",
      empty: "No projects matched that search.",
      proEyebrow: "Professional experience",
      proTitle: "Projects at work",
      proDesc: "Work delivered in a professional environment; each card shows the company. General description only: no code, screenshots or internal information.",
      professional: "Professional",
      mine: "My contribution",
      learned: "What I learned from it",
      personalEyebrow: "Personal projects",
      personalTitle: "Ideas I built",
      personalDesc: "Experiments, tools and products of my own.",
      details: "View details",
      projectImage: "Project image",
      system: "System",
    }
  : {
      title: "Proyectos",
      description:
        "Proyectos desarrollados por JavierSG: ERP, apps móviles, asistentes de IA y sistemas empresariales.",
      eyebrow: "Portafolio",
      subtitle: "Trabajo profesional y proyectos personales. Filtra por tecnología o nombre.",
      placeholder: "Buscar por tecnología o nombre...",
      searchAria: "Buscar proyectos por nombre o tecnología",
      count: "repositorios encontrados",
      empty: "No se encontraron proyectos con esa búsqueda.",
      proEyebrow: "Experiencia profesional",
      proTitle: "Proyectos en empresa",
      proDesc: "Desarrollos realizados en un entorno profesional, sin código ni información interna.",
      professional: "Profesional",
      mine: "Mi participación",
      learned: "Qué me dejó",
      personalEyebrow: "Proyectos personales",
      personalTitle: "Ideas que construí",
      personalDesc: "Experimentos, herramientas y productos propios.",
      details: "Ver detalles",
      projectImage: "Imagen del proyecto",
      system: "System",
    };

const projects = (await getCollection(isEn ? "projectsEn" : "projects")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const cubits = (await getCollection(isEn ? "cubitsEn" : "cubits")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<Layout
  title={`${L.title} | JavierSG`}
  description={L.description}
  locale={locale}
  alternate
>
  <section class="shell py-14 md:py-20">
    {/* Encabezado + buscador */}
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        eyebrow={L.eyebrow}
        title={L.title}
        description={L.subtitle}
        spacing="none"
      />

      <div class="relative w-full lg:w-96" data-reveal style="--reveal-delay: 120ms">
        <svg
          class="pointer-events-none absolute top-1/2 left-4 h-4.5 w-4.5 -translate-y-1/2 text-ink-3"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          id="project-search"
          type="text"
          placeholder={L.placeholder}
          aria-label={L.searchAria}
          class="field pl-12"
        />
      </div>
    </div>

    <p
      class="mt-6 font-mono text-xs tracking-[0.2em] text-ink-3 uppercase"
      role="status"
      aria-live="polite"
      data-reveal
      style="--reveal-delay: 160ms"
    >
      <span id="projects-count" class="text-brand">{projects.length}</span>
      {L.count}
    </p>

    {/* --- EXPERIENCIA PROFESIONAL --- */}
    <section class="mt-16">
      <SectionHeading
        eyebrow={L.proEyebrow}
        title={L.proTitle}
        description={L.proDesc}
      />

      <div class="grid gap-6 md:grid-cols-2">
        {
          cubits.map((project, index) => {
            const { name, company, subtitle, description, participation, technologies, learnings } =
              project.data;
            return (
              <article
                class="card card--hover flex h-full flex-col overflow-hidden"
                data-reveal
                style={`--reveal-delay: ${index * 90}ms`}
              >
                <div class="relative overflow-hidden border-b border-line bg-gradient-to-br from-brand-2/25 via-surface to-surface px-6 py-7">
                  <span class="chip chip--violet absolute top-4 left-4">
                    {L.professional}
                  </span>
                  <span class="chip absolute top-4 right-4">{company}</span>
                  <p class="mt-6 font-display text-2xl leading-tight font-bold text-white sm:text-3xl">
                    {name}
                  </p>
                </div>

                <div class="flex flex-1 flex-col gap-5 p-6">
                  <div>
                    <p class="font-mono text-[0.66rem] tracking-[0.24em] text-accent uppercase">
                      {subtitle}
                    </p>
                    <p class="mt-2 text-sm leading-relaxed text-ink-2">{description}</p>
                  </div>

                  <div>
                    <p class="font-mono text-[0.66rem] tracking-[0.24em] text-ink-3 uppercase">
                      {L.mine}
                    </p>
                    <p class="mt-1.5 text-sm leading-relaxed text-ink-2">{participation}</p>
                  </div>

                  {technologies.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {technologies.map((tech) => (
                        <span class="chip">{tech}</span>
                      ))}
                    </div>
                  )}

                  {learnings && (
                    <div class="mt-auto rounded-xl border-l-2 border-brand/60 bg-white/[0.03] px-4 py-3">
                      <p class="font-mono text-[0.66rem] tracking-[0.24em] text-ink-3 uppercase">
                        {L.learned}
                      </p>
                      <p class="mt-1 text-sm leading-relaxed text-ink-2 italic">{learnings}</p>
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    {/* --- PROYECTOS PERSONALES --- */}
    <section class="mt-20">
      <SectionHeading
        eyebrow={L.personalEyebrow}
        title={L.personalTitle}
        description={L.personalDesc}
      />

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project, index) => {
            const { id, data } = project;
            const { title, image, description, frameworks, type, status } = data;
            const isPortrait = image.width < image.height;
            const statusInfo = status ? projectStatus[status] : undefined;

            return (
              <article
                data-search={`${title ?? ""} ${description ?? ""} ${type ?? ""} ${(frameworks ?? []).join(" ")}`.toLowerCase()}
                class="card card--hover group flex h-full flex-col overflow-hidden"
                data-reveal
                style={`--reveal-delay: ${(index % 3) * 80}ms`}
              >
                <a href={link(`/projects/${id}`)} class="flex h-full flex-col">
                  <div class="relative aspect-video overflow-hidden">
                    <Image
                      transition:name={`img-${id}`}
                      src={image}
                      alt={title ?? L.projectImage}
                      class:list={[
                        "h-full w-full object-cover transition-transform duration-700 group-hover:scale-105",
                        isPortrait && "object-top",
                      ]}
                    />
                    <div
                      class="absolute inset-0 bg-gradient-to-t from-surface via-surface/20 to-transparent"
                    ></div>

                    <span class="chip absolute top-3 right-3">{type || L.system}</span>
                    {statusInfo && (
                      <span class:list={["chip absolute top-3 left-3", statusInfo.cls]}>
                        {isEn ? statusInfo.labelEn : statusInfo.label}
                      </span>
                    )}
                  </div>

                  <div class="flex flex-1 flex-col gap-3 p-6">
                    <h3 class="text-xl leading-snug font-semibold transition-colors group-hover:text-brand">
                      {title}
                    </h3>

                    <p class="line-clamp-3 text-sm leading-relaxed text-ink-2">{description}</p>

                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {(frameworks ?? []).slice(0, 4).map((tech) => (
                        <span class="chip">{tech}</span>
                      ))}
                    </div>

                    <span
                      class="mt-auto inline-flex items-center gap-2 pt-4 font-mono text-[0.68rem] tracking-[0.2em] text-ink-2 uppercase transition-all group-hover:gap-3.5 group-hover:text-brand"
                    >
                      {L.details}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        class="h-3.5 w-3.5"
                      >
                        <path d="M5 12h14m-7-7l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>

    <p
      id="projects-empty"
      role="status"
      aria-live="polite"
      class="hidden py-16 text-center text-ink-2 italic"
    >
      {L.empty}
    </p>
  </section>
</Layout>

<script>
  function initProjectSearch() {
    const input = document.getElementById("project-search") as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-search]"));
    const counter = document.getElementById("projects-count");
    const empty = document.getElementById("projects-empty");
    if (!input) return;

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const matches = (card.dataset.search ?? "").includes(query);
        card.classList.toggle("hidden", !matches);
        if (matches) visible++;
      }

      if (counter) counter.textContent = String(visible);
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    });
  }

  document.addEventListener("astro:page-load", initProjectSearch);
</script>
