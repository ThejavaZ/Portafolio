---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: "en" } }];
}

const locale = Astro.params.locale === "en" ? "en" : "es";
const isEn = locale === "en";

const L = isEn
  ? {
      metaTitle: "Contact | JavierSG",
      metaDescription:
        "Got a project or a job opening? Reach out: contact form, email and JavierSG's social profiles.",
      eyebrow: "Contact",
      title: "Shall we talk backend?",
      description: "Send me a message or find me on social media. I reply fast and straight to the point.",
      name: "Name",
      namePlaceholder: "e.g. John Doe",
      email: "Email",
      emailPlaceholder: "you@example.com",
      subject: "Subject",
      subjectPlaceholder: "How can I help you?",
      message: "Message",
      messagePlaceholder: "Write your message here...",
      honeypot: "Do not fill this out:",
      submit: "Send message",
      sending: "Sending…",
      note: "Usually replying within 24 hours",
      successTitle: "Message sent",
      successText: "Thanks for writing. I'll get back to you as soon as I can, usually within 24 hours.",
      sendAnother: "Send another message",
      location: "Location: Hermosillo, Mexico",
      mapTitle: "Location map: Hermosillo, Sonora, Mexico",
      linkedin: "LinkedIn profile",
      emailLabel: "Email",
    }
  : {
      metaTitle: "Contacto | JavierSG",
      metaDescription:
        "¿Tienes un proyecto o una vacante? Escríbeme: formulario directo, correo y redes de JavierSG.",
      eyebrow: "Contacto",
      title: "¿Hablamos de backend?",
      description: "Envíame un mensaje o búscame en mis redes. Respondo rápido y sin rodeos.",
      name: "Nombre",
      namePlaceholder: "Ej. John Doe",
      email: "Email",
      emailPlaceholder: "tu@email.com",
      subject: "Asunto",
      subjectPlaceholder: "¿En qué puedo ayudarte?",
      message: "Mensaje",
      messagePlaceholder: "Escribe tu propuesta aquí...",
      honeypot: "No llenes este campo:",
      submit: "Enviar mensaje",
      sending: "Enviando…",
      note: "Respuesta habitual en menos de 24 h",
      successTitle: "Mensaje enviado",
      successText:
        "Gracias por escribirme. Te contesto lo antes posible, normalmente en menos de 24 h.",
      sendAnother: "Enviar otro mensaje",
      location: "Ubicación: Hermosillo, México",
      mapTitle: "Mapa de ubicación: Hermosillo, Sonora, México",
      linkedin: "Perfil de LinkedIn",
      emailLabel: "Correo",
    };

const socials = [
  {
    name: "GitHub",
    href: "https://github.com/ThejavaZ",
    icon: "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z",
    label: "github.com/ThejavaZ",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/javier-armando-sarmiento-gil-aa10b0249/",
    icon: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21h-4V9Z",
    label: L.linkedin,
  },
  {
    name: L.emailLabel,
    href: "mailto:jsdash10000@gmail.com",
    icon: "M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Zm2 .4V17h14V7.4l-7 4.6-7-4.6ZM7.4 7 12 10.1 16.6 7H7.4Z",
    label: "jsdash10000@gmail.com",
  },
];
---

<Layout
  title={L.metaTitle}
  description={L.metaDescription}
  locale={locale}
  alternate
>
  <section class="shell py-14 md:py-20">
    <SectionHeading
      eyebrow={L.eyebrow}
      title={L.title}
      suffix=""
      description={L.description}
      align="center"
    />

    <div class="grid gap-8 lg:grid-cols-2">
      {/* ---------- Formulario ---------- */}
      <form
        id="contact-form"
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="card p-6 sm:p-8"
        data-reveal
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden">
          <label>{L.honeypot} <input name="bot-field" /></label>
        </p>

        <div class="grid gap-5 md:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="name" class="font-mono text-[0.68rem] tracking-[0.2em] text-ink-3 uppercase"
              >{L.name}</label
            >
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder={L.namePlaceholder}
              class="field"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="email" class="font-mono text-[0.68rem] tracking-[0.2em] text-ink-3 uppercase"
              >{L.email}</label
            >
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder={L.emailPlaceholder}
              class="field"
            />
          </div>
        </div>

        <div class="mt-5 flex flex-col gap-2">
          <label for="subject" class="font-mono text-[0.68rem] tracking-[0.2em] text-ink-3 uppercase"
            >{L.subject}</label
          >
          <input
            type="text"
            id="subject"
            name="subject"
            required
            placeholder={L.subjectPlaceholder}
            class="field"
          />
        </div>

        <div class="mt-5 flex flex-col gap-2">
          <label for="message" class="font-mono text-[0.68rem] tracking-[0.2em] text-ink-3 uppercase"
            >{L.message}</label
          >
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder={L.messagePlaceholder}
            class="field resize-none"></textarea>
        </div>

        <button
          type="submit"
          data-sending={L.sending}
          class="btn btn--primary btn--lg mt-7 w-full"
        >
          {L.submit}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4.5 w-4.5">
            <path d="M5 12h14m-7-7l7 7-7 7" />
          </svg>
        </button>

        <p class="mt-4 text-center font-mono text-[0.66rem] tracking-[0.14em] text-ink-3 uppercase">
          {L.note}
        </p>
      </form>

      {/* Confirmación tras enviar (se muestra con el script de abajo) */}
      <div
        id="form-success"
        class="card hidden flex-col items-center gap-5 p-10 text-center"
        role="status"
        aria-live="polite"
        tabindex="-1"
      >
        <span class="flex h-14 w-14 items-center justify-center rounded-full bg-good/15 text-good">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-7 w-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
          </svg>
        </span>
        <div class="space-y-2">
          <h2 class="text-2xl font-bold">{L.successTitle}</h2>
          <p class="text-ink-2">{L.successText}</p>
        </div>
        <button type="button" id="form-reset" class="btn btn--ghost btn--sm">
          {L.sendAnother}
        </button>
      </div>

      {/* ---------- Redes + mapa ---------- */}
      <div class="flex flex-col gap-6">
        <div class="grid gap-4 sm:grid-cols-3" data-reveal style="--reveal-delay: 80ms">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target={social.href.startsWith("mailto:") ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="card card--hover group flex flex-col items-center gap-3 p-6 text-center"
              >
                <span class="flex h-12 w-12 items-center justify-center rounded-xl border border-line bg-surface-2 text-ink-2 transition-colors group-hover:border-brand/50 group-hover:text-white">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
                    <path d={social.icon} />
                  </svg>
                </span>
                <span class="font-mono text-[0.66rem] tracking-[0.14em] text-ink-3 uppercase">
                  {social.name}
                </span>
                <span class="max-w-full truncate text-xs text-ink-3">{social.label}</span>
              </a>
            ))
          }
        </div>

        <div class="card relative flex-1 overflow-hidden p-2" data-reveal style="--reveal-delay: 140ms">
          <div class="relative h-full min-h-[280px] overflow-hidden rounded-[1.1rem]">
            <span
              class="chip absolute top-3 left-3 z-10 bg-surface/90 backdrop-blur-md"
            >
              {L.location}
            </span>
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d111516.34005086815!2d-111.0289893081123!3d29.088914652253337!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x86ce836f6630f57d%3A0x600b33230a133f92!2sHermosillo%2C%20Son.!5e0!3m2!1ses-419!2smx!4v1700000000000!5m2!1ses-419!2smx"
              title={L.mapTitle}
              class="absolute inset-0 h-full w-full border-none grayscale invert contrast-125 opacity-80"
              allowfullscreen=""
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const success = document.getElementById("form-success");
    const reset = document.getElementById("form-reset");
    if (!form || !success || form.dataset.bound === "1") return;

    form.dataset.bound = "1";
    const submitButton = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const originalLabel = submitButton?.innerHTML ?? "";

    const showSuccess = () => {
      form.classList.add("hidden");
      success.classList.remove("hidden");
      success.classList.add("flex");
      success.focus();
      success.scrollIntoView({ behavior: "smooth", block: "center" });
    };

    const restoreButton = () => {
      if (!submitButton) return;
      submitButton.disabled = false;
      submitButton.innerHTML = originalLabel;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = submitButton.dataset.sending ?? "…";
      }

      try {
        if (import.meta.env.DEV) {
          // Sin backend en local: simulamos el envío para ver el estado
          await new Promise((resolve) => setTimeout(resolve, 700));
        } else {
          const params = new URLSearchParams();
          new FormData(form).forEach((value, key) => {
            if (typeof value === "string") params.append(key, value);
          });

          const response = await fetch("/", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: params.toString(),
          });

          if (!response.ok) throw new Error(`Error ${response.status}`);
        }

        showSuccess();

        // Evento de analítica (inofensivo si no hay script cargado)
        const umami = (
          window as typeof window & { umami?: { track: (event: string) => void } }
        ).umami;
        umami?.track("contact-submit");
      } catch {
        // Si falla la petición, dejamos que el navegador haga el POST nativo
        restoreButton();
        form.submit();
      }
    });

    reset?.addEventListener("click", () => {
      form.reset();
      success.classList.add("hidden");
      success.classList.remove("flex");
      form.classList.remove("hidden");
      form.querySelector<HTMLElement>("input")?.focus();
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
