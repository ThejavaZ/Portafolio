---
import Layout from "../layouts/Layout.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
---

<Layout
  title="Página no encontrada | JavierSG"
  description="La página que buscas no existe. Vuelve al inicio o explora los proyectos de JavierSG."
>
  <section class="shell flex min-h-[65vh] flex-col items-center justify-center py-20 text-center">
    <p class="eyebrow" data-es="Error 404" data-en="Error 404">Error 404</p>

    <h1
      class="text-grad mt-6 text-[5.5rem] leading-none font-bold tracking-tighter sm:text-[9rem]"
      data-reveal
      style="--reveal-delay: 60ms"
    >
      404
    </h1>

    <p
      class="mt-4 max-w-md text-lg leading-relaxed text-ink-2"
      data-reveal
      style="--reveal-delay: 120ms"
      data-es="Esta ruta no existe (o ya no vive aquí). Parece un <code class='rounded border border-line bg-white/5 px-2 py-0.5 font-mono text-[0.9em] text-accent'>git push</code> accidental."
      data-en="This route doesn't exist (or it no longer lives here). Looks like an accidental <code class='rounded border border-line bg-white/5 px-2 py-0.5 font-mono text-[0.9em] text-accent'>git push</code>."
    >
      Esta ruta no existe (o ya no vive aquí). Parece un <code
        class="rounded border border-line bg-white/5 px-2 py-0.5 font-mono text-[0.9em] text-accent"
        >git push</code
      > accidental.
    </p>

    <div class="mt-9 flex flex-wrap justify-center gap-3" data-reveal style="--reveal-delay: 180ms">
      <ButtonLink href="/" data-href-en="/en">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V21h14V9.5" />
        </svg>
        <span data-es="Ir al inicio" data-en="Go to home">Ir al inicio</span>
      </ButtonLink>
      <ButtonLink href="/projects" variant="ghost" data-href-en="/en/projects">
        <span data-es="Ver proyectos" data-en="View projects">Ver proyectos</span>
      </ButtonLink>
    </div>
  </section>
</Layout>

<script>
  // El 404 es un único archivo estático: si la petición venía de /en/...
  // traducimos el contenido en el cliente.
  function applyLocaleTo404() {
    const isEn = window.location.pathname.startsWith("/en");
    document.documentElement.lang = isEn ? "en" : "es";

    if (!isEn) return;

    document.title = "Page not found | JavierSG";

    document.querySelectorAll<HTMLElement>("[data-en]").forEach((element) => {
      if (element.dataset.en) element.innerHTML = element.dataset.en;
    });

    document.querySelectorAll<HTMLAnchorElement>("a[data-href-en]").forEach((anchor) => {
      if (anchor.dataset.hrefEn) anchor.href = anchor.dataset.hrefEn;
    });
  }

  applyLocaleTo404();
  document.addEventListener("astro:page-load", applyLocaleTo404);
</script>
